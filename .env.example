# Create a bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace_with_your_bot_token
# Optional: used by command deployment; auto-detected when omitted.
DISCORD_CLIENT_ID=
# Optional: set to deploy commands instantly to one development server.
DISCORD_GUILD_ID=
DEFAULT_LANGUAGE=en
MCAPI_BASE_URL=https://mcapi.tr/api/v1
POLL_INTERVAL_SECONDS=120
MAX_MONITORS_PER_GUILD=5
MAX_MONITORS_TOTAL=50
DATA_DIR=./data
