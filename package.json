{
  "name": "minecraft-server-status-discord-bot",
  "version": "1.0.0",
  "description": "Self-hosted Minecraft Java and Bedrock status Discord bot powered by MCAPI.TR.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.17.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "deploy": "tsx src/deploy.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src tests docs README.md README.tr.md *.json *.yml",
    "format:check": "prettier --check src tests docs README.md README.tr.md *.json *.yml",
    "verify": "npm run check && npm test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "repository": { "type": "git", "url": "https://github.com/Nexuby/minecraft-server-status-discord-bot.git" },
  "homepage": "https://github.com/Nexuby/minecraft-server-status-discord-bot#readme",
  "bugs": "https://github.com/Nexuby/minecraft-server-status-discord-bot/issues",
  "license": "MIT",
  "keywords": ["minecraft", "discord-bot", "server-status", "mcapi", "bedrock", "java-edition"],
  "dependencies": { "discord.js": "14.28.1", "dotenv": "^17.2.3", "zod": "^4.1.12" },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "5.1.0",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  }
}
